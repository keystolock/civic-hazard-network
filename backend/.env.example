# ─── .env.example ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your real credentials.
# The application reads these values via python-dotenv at startup.
# NEVER commit the real `.env` file to version control.

# ── Google Gemini AI ───────────────────────────────────────────────────────────
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_API_KEY_HERE

# ── Telegram Bot ───────────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram to get this token
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# The chat_id or channel_id your bot sends alerts to.
# Tip: send any message to your bot, then call:
#   GET https://api.telegram.org/bot<TOKEN>/getUpdates
# and look for the "chat" → "id" field.
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# ── Database ───────────────────────────────────────────────────────────────────
# Default: local SQLite file (perfect for demo).
# For production, replace with a PostgreSQL URL:
#   DATABASE_URL=postgresql+asyncpg://user:password@host/db
DATABASE_URL=sqlite+aiosqlite:///./civic_hazard.db

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins that are allowed to call the API
FRONTEND_ORIGINS=http://localhost:3000,https://your-production-domain.com

# ── Upload Storage ─────────────────────────────────────────────────────────────
# Directory where uploaded hazard photos are saved on disk
UPLOAD_DIR=uploads
